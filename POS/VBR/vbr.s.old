		# Set 16bit format and ip origin
		.code16
		.global _start


		# short jump to correct memory address
		.org 0x0000
_start:
		jmp hop1
		nop
		# BPB / EBPB bis 0x5A

.org 0x0B
BPB_BytesPerSector:		.word	# 0x0B  → immer 512 (bootfähig)
BPB_SectorsPerCluster:	.byte	# 0x0D
BPB_ReservedSectors:	.word	# 0x0E  (inkl. VBR)
BPB_NumFATs:			.byte	# 0x10
BPB_RootEntryCount:		.word	# 0x11
BPB_TotalSectors16:		.word	# 0x13
BPB_Media:				.byte	# 0x15
BPB_SectorsPerFAT:		.word	# 0x16
BPB_SectorsPerTrack:	.word	# 0x18  (für CHS, optional)
BPB_NumHeads:			.word	# 0x1A  (für CHS, optional)
BPB_HiddenSectors:		.long	# 0x1C  ← **KRITISCH**
BPB_TotalSectors32:		.long	# 0x20  (falls 0x13 == 0)

		.org 0x005A
hop1:
		ljmp $0x07C0, $hop2


		# real program start
hop2:

		# set stack with interrupts disabled
		cli
		movw $0x9000, %ax
		movw %ax, %ss
		movw $0xffff, %sp
		sti

		# set data segments
		movw $0x07C0, %ax
		movw %ax, %ds
		movw $0x8000, %ax
		movw %ax, %es
		movb %dl, disk

		# clear screen
		movw $0x0600, %ax	# AH=06h, AL=00h
		movb $0x07, %bh		# attributes: light gray on black
		xorw %cx, %cx		# CH=row=0, CL=col=0
		mov $0x184F, %dx	# DH=row=24, DL=79 (80x25)
		int $0x10

		# text cursor to top left
		movw $0x0200, %ax	# AH=02h
		xorw %bx, %bx		# BH=0 (page 0)
		xorw %dx, %dx		# DH=0, DL=0
		int $0x10

		# teletype
		movw $msg, %si
		call hop8

		# test for LBA
		movb $0x41, %ah
		movw $0x55AA, %bx
		int $0x13
		jc hop5
		cmpw $0xAA55, %bx
		jne hop5
		testb $1, %cx
		jz hop5

		# calculate FAT start sector
		movw BPB_HiddenSectors, %ax
		movw 2(BPB_HiddenSectors), %dx
		addw BPB_ReservedSectors, %ax
		adcw $0, %dx
		movw %ax, FirstFAT_LBA
		movw %dx, 2(FirstFAT_LBA)

		# calculate rootdir start sector
		movw BPB_SectorsPerFAT, %ax
		xorw %bx, %bx
		movb BPB_NumFATs, %bx
		mulw %bx
		addw FirstFAT_LBA, %ax
		adcw 2(FirstFAT_LBA), %dx
		movw %ax, FirstRoot_LBA
		movw %dx, 2(FirstRoot_LBA)

		# calculate rootdir entry sector count
		movw BPB_RootEntryCount, %ax
		movw %ax, RemainingEntries
		shlw $5, %ax	# *32
		addw $511, %ax
		shrw $9, %ax	# /512
		movw %ax, RootDirSectors

		# calculate data start sector
		movw RootDirSectors, %ax # not necessary but clearer?
		xorw %dx, %dx
		addw FirstRoot_LBA, %ax
		adcw 2(FirstRoot_LBA), %dx
		movw %ax, FirstData_LBA
		movw %dx, 2(FirstData_LBA)

		movw $1, dap_count
		movw $0, dap_offset
		movw $0x8000, dap_segment
		movw FirstRoot_LBA, dap_lba
		movw 2(FirstRoot_LBA), dap_lba+2
		movw $0, dap_lba+4
		movw $0, dap_lba+6

		# read LBA into dap
		movb $0x42, %ah
		movb disk, %dl
		movw $dap, %si
		int $0x13
		jc hop5

		cld

hop10:
		movw $0x10, %cx
		xor %di, %di

hop11:

		cmpb $0, %es:(%di)
		je hop5

		pushw %di
		pushw %si
		pushw %cx

		cmpb $0xE5, %es:(%di)
		je hop12

		movw $KernelName, %si	# DS:SI = Vergleichsstring
		movw $11, %cx			# 11 Bytes vergleichen
		repe cmpsb				# vergleicht ES:DI mit DS:SI
		jne hop12

		popw %cx
		popw %si
		popw %di

		jmp hop13

hop12:

		popw %cx
		popw %si
		popw %di

		# auf letzten eintrag prüfen, und gegebenenfalls beide loops verlassen
		decw RemainingEntries
		je hop5

		addw $0x20, %di
		loop hop11

		addw $1, dap_lba
		adcw $0, dap_lba+2
		# read LBA into dap
		movb $0x42, %ah
		movb disk, %dl
		movw $dap, %si
		int $0x13
		jc hop5

		jmp hop10

hop13:	# init data read

		xorw %ax, %ax
		movw %ax, KernelOffset

		# DI zeigt auf Entry-Start
		movw %es:26(%di), %ax	# AX = FirstCluster
		movw %ax, KernelCluster
		movw %es:28(%di), %ax
		movw %ax, KernelSize
		movw %es:30(%di), %ax
		movw %ax, KernelSize+2

		movw KernelCluster, %ax
		subw $2, %ax
		xorw %dx, %dx
		xorw %bx, %bx
		movb BPB_SectorsPerCluster, %bl
		mulw %bx

hop14:	# repeat data read

		movw FirstData_LBA, dap_lba
		movw 2(FirstData_LBA), dap_lba+2
		addw %ax, dap_lba
		adcw %dx, dap_lba+2
		movw $0, dap_lba+4
		movw $0, dap_lba+6

		xorw %ax, %ax
		movb BPB_SectorsPerCluster, %al
		movw %ax, dap_count
		movw KernelOffset, dap_offset
		movw $0x1000, dap_segment

		# read LBA into dap
		movb $0x42, %ah
		movb disk, %dl
		movw $dap, %si
		int $0x13
		jc hop5
		
		xorw %ax, %ax
		movb BPB_SectorsPerCluster, %al
		shlw $9, %ax # *512
		addw %ax, KernelOffset
		jnc no_carry
		addw $0x1000, KernelSegment
no_carry:

		cli

		# Zieladresse: ES:BX = 1000:0000
		movw $0x1000, %ax
		movw %ax, %es
		xorw %bx, %bx

		# BIOS Disk Read
		/* OLD CODE!!!
		movb $0x02, %ah	# Funktion: Read sectors
		movb $0x01, %al	# Anzahl Sektoren (z.B. 1)
		movb $0x00, %ch	# Cylinder 0
		movb $0x02, %cl	# Sector 2 (MBR ist Sector 1!)
		movb $0x00, %dh	# Head 0
		movb disk, %dl	# DL = Boot Drive (vom BIOS gesetzt!)
		int  $0x13
		jc hop5			# Carry = Fehler
		*/

		sti
		ljmp $0x1000, $0x0000	# JUMP!
    
		# go into sleep mode
hop5:
		# teletype
		movw $err, %si
		call hop8

hop7:
		cli
		hlt
		jmp .

hop8: # teletype
		lodsb			# AL = [DS:SI++]
		testb %al, %al
		jnz hop9
		ret
hop9:
		movb $0x0E, %ah
		xorw %bx, %bx	# BL (color, ignored) BH=0 (page 0)
		int $0x10
		jmp hop8

disk:	.byte 0

FirstFAT_LBA:	.long 0
FirstRoot_LBA:	.long 0
RootDirSectors:	.word 0
FirstData_LBA:	.long 0

RemainingEntries:	.word 0
KernelCluster:		.word 0
KernelSize:			.quad 0
KernelOffset:		.word 0


dap:
				.byte 0x10      # Größe
				.byte 0x00
dap_count:		.word 0         # Anzahl Sektoren
dap_offset:		.word 0         # Offset
dap_segment:	.word 0         # Segment
dap_lba:		.quad 0         # 64-bit LBA

KernelName:
    .ascii "KERNEL  BIN" # exakt 11 Bytes

msg:
		.ascii "Loader Aktiv."
		.byte 0

err:
		.ascii "READ ERROR."
		.byte 0

		# boot signature
		.fill 510 - (. - _start), 1, 0
		.word 0xAA55
